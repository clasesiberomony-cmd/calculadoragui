}

/* ===== QLabel ===== */
QLabel {
    color: #333333;
    font-weight: 500;
}

QLabel#label_resultado {
    color: #333333;
	font-size: 48pt;
    font-weight: 500;
}

/* ===== QLineEdit ===== */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #DADADA;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #4A90E2;
}

QLineEdit:focus {
    border: 1px solid #4A90E2;
    background-color: #FFFFFF;
}

/* ===== QPushButton ===== */
QPushButton {
    background-color: #4A90E2;
    color: white;
    border-radius: 6px;
    padding: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #357ABD;
}

QPushButton:pressed {
    background-color: #2C5FA3;
}

/* ===== Botón secundario (si quieres usarlo) ===== */
QPushButton#btnSecundario {
    background-color: #E0E0E0;
    color: #333333;
}

QPushButton#btnSecundario:hover {
    background-color: #D5D5D5;
}</string>
